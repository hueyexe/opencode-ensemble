{
  "name": "@hueyexe/opencode-ensemble-swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Swarm orchestration for OpenCode Ensemble — a Temporal-backed fleet of headless opencode serve agents",
  "license": "MIT",
  "scripts": {
    "worker": "bun run src/worker.ts",
    "cli": "bun run src/cli.ts",
