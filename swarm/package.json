    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}