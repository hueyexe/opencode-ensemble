{
  "name": "@hueyexe/opencode-ensemble",
  "version": "0.19.0",
  "description": "Agent teams for OpenCode \u2014 parallel agents with peer-to-peer communication, shared tasks, and coordinated execution",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hueyexe/opencode-ensemble"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agent",
    "team",
    "multi-agent",
    "parallel",
    "orchestration"
  ],
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "social-preview.png"
  ],
  "scripts": {
    "lint": "bunx biome lint src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval:smoke": "bun eval/smoke.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/bun": "latest",
    "solid-js": "1.9.4"
  },
  "peerDependencies": {
    "typescript": "^5",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.18",
    "@opencode-ai/sdk": "^1.17.18",
    "@opencode/plugin": "2.0.3"
  }
}